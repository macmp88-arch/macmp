---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'MacMP · 发现好用的 Mac 软件与优惠',
  description = 'MacMP 专注精选正版 Mac 软件、优惠情报、工作流指南与本地 AI 教程，帮你把 Mac 用得更好。',
  path = '/',
  image = '/favicon.svg',
  noindex = false,
} = Astro.props;

const ogImage = new URL(image, Astro.site).toString();

const memberEnabled = import.meta.env.PUBLIC_MEMBER_ENABLED === 'true';
const nav = [
  { href: '/software/', zh: '软件推荐', en: 'Software', active: path.startsWith('/software') },
  { href: '/guides/', zh: '专题指南', en: 'Guides', active: path.startsWith('/guides') },
  { href: '/deals/', zh: '优惠情报', en: 'Deals', active: path.startsWith('/deals') },
  { href: '/ai-local/', zh: '本地 AI', en: 'Local AI', active: path.startsWith('/ai-local') },
  { href: '/tools/', zh: '素材与工具', en: 'Tools', active: path.startsWith('/tools') },
  { href: '/support/', zh: '支持我们', en: 'Support', active: path.startsWith('/support') },
  ...(memberEnabled ? [{ href: '/vip/', zh: 'VIP 会员', en: 'VIP', active: path.startsWith('/vip') }] : []),
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="impact-site-verification" value="4eb0a404-6f68-49ea-afa3-39b9198ef236" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={path.startsWith('/guides/') ? 'article' : 'website'} />
    <meta property="og:url" content={new URL(path, Astro.site).toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <Analytics />
    <script is:inline>
      (function(){try{var l=localStorage.getItem('lang')||'zh';document.documentElement.setAttribute('lang', l==='en'?'en':'zh-CN');}catch(e){}})();
    </script>
    <script is:inline type="text/javascript">
(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A7823876-a1c9-450d-95ec-cbdeedd2f2851.js','script','impactStat',document,window);impactStat('transformLinks');impactStat('trackImpression');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a class="brand" href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2a2.2 2.2 0 0 0-2.2 2.2v.4C8 5 7 5.9 6.6 6.9c-.3.8-.3 1.7-.1 2.5l-2.8 2.8a2 2 0 0 0 0 2.8l5 5a2 2 0 0 0 2.8 0l2.8-2.8c.8.2 1.7.2 2.5-.1 1-.4 1.9-1.4 2.3-3.3h.4A2.2 2.2 0 0 0 22 12a2.2 2.2 0 0 0-2.2-2.2h-.4c-.4-1.9-1.3-2.9-2.3-3.3-.8-.3-1.7-.3-2.5-.1l-.4-.4V5.6A2.2 2.2 0 0 0 12 2Z" fill="#0071e3"/>
          </svg>
          <span>Mac<span style="color:var(--blue)">MP</span></span>
        </a>
        <div style="display:flex;align-items:center;gap:20px">
          <nav class="nav">
            {nav.map((item) => (
              <a href={item.href} class={item.active ? 'active' : ''}>
                <span class="zh">{item.zh}</span><span class="en">{item.en}</span>
              </a>
            ))}
          </nav>
          <button class="lang-toggle" id="langToggle" type="button" aria-label="Switch language">
            <span class="zh">English</span><span class="en">中文</span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="cols">
          <div>
            <h4><span class="zh">发现</span><span class="en">Discover</span></h4>
            <ul>
              <li><a href="/software/"><span class="zh">软件推荐</span><span class="en">Software</span></a></li>
              <li><a href="/guides/"><span class="zh">专题指南</span><span class="en">Guides</span></a></li>
              <li><a href="/deals/"><span class="zh">优惠情报</span><span class="en">Deals</span></a></li>
              <li><a href="/ai-local/"><span class="zh">本地 AI</span><span class="en">Local AI</span></a></li>
              {memberEnabled && <li><a href="/vip/"><span class="zh">VIP 会员</span><span class="en">VIP Membership</span></a></li>}
            </ul>
          </div>
          <div>
            <h4><span class="zh">支持</span><span class="en">Support</span></h4>
            <ul>
              <li><a href="/support/"><span class="zh">打赏支持</span><span class="en">Donate</span></a></li>
              <li><a href="/#subscribe"><span class="zh">订阅邮件</span><span class="en">Newsletter</span></a></li>
              <li><a href="/about/"><span class="zh">关于本站</span><span class="en">About</span></a></li>
            </ul>
          </div>
          <div>
            <h4><span class="zh">声明</span><span class="en">Disclosure</span></h4>
            <ul>
              <li><a href="/about/"><span class="zh">透明变现</span><span class="en">Affiliate Disclosure</span></a></li>
              <li><a href="/about/"><span class="zh">联系我们</span><span class="en">Contact</span></a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <p><span class="zh">本站部分链接为联盟链接，购买不会增加你的花费，但可能为我们带来佣金，感谢支持。</span><span class="en">Some links are affiliate links. Purchases through them cost you nothing extra but may earn us a commission. Thanks for your support!</span></p>
          <p>© {new Date().getFullYear()} macmp.com · <span class="zh">Apple 与 macOS 是 Apple Inc. 的商标。</span><span class="en">Apple and macOS are trademarks of Apple Inc.</span></p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('langToggle').addEventListener('click', function(){
        var en = document.documentElement.getAttribute('lang') === 'en';
        document.documentElement.setAttribute('lang', en ? 'zh-CN' : 'en');
        try{localStorage.setItem('lang', en ? 'zh' : 'en');}catch(e){}
      });
    </script>
  </body>
</html>
