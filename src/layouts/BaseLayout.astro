---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'MacMP · 发现好用的 Mac 软件与优惠',
  description = 'MacMP 专注精选正版 Mac 软件、限免优惠与本地 AI 教程，帮你把 Mac 用得更好。',
  path = '/',
} = Astro.props;

const nav = [
  { href: '/software/', label: '软件推荐', active: path.startsWith('/software') },
  { href: '/deals/', label: '优惠情报', active: path.startsWith('/deals') },
  { href: '/ai-local/', label: '本地 AI', active: path.startsWith('/ai-local') },
  { href: '/support/', label: '支持我们', active: path.startsWith('/support') },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site).toString()} />
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a class="brand" href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2a2.2 2.2 0 0 0-2.2 2.2v.4C8 5 7 5.9 6.6 6.9c-.3.8-.3 1.7-.1 2.5l-2.8 2.8a2 2 0 0 0 0 2.8l5 5a2 2 0 0 0 2.8 0l2.8-2.8c.8.2 1.7.2 2.5-.1 1-.4 1.9-1.4 2.3-3.3h.4A2.2 2.2 0 0 0 22 12a2.2 2.2 0 0 0-2.2-2.2h-.4c-.4-1.9-1.3-2.9-2.3-3.3-.8-.3-1.7-.3-2.5-.1l-.4-.4V5.6A2.2 2.2 0 0 0 12 2Z" fill="#0071e3"/>
          </svg>
          <span>Mac<span style="color:var(--blue)">MP</span></span>
        </a>
        <nav class="nav">
          {nav.map((item) => (
            <a href={item.href} class={item.active ? 'active' : ''}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="cols">
          <div>
            <h4>发现</h4>
            <ul>
              <li><a href="/software/">软件推荐</a></li>
              <li><a href="/deals/">优惠情报</a></li>
              <li><a href="/ai-local/">本地 AI</a></li>
            </ul>
          </div>
          <div>
            <h4>支持</h4>
            <ul>
              <li><a href="/support/">打赏支持</a></li>
              <li><a href="/#subscribe">订阅邮件</a></li>
              <li><a href="/about/">关于本站</a></li>
            </ul>
          </div>
          <div>
            <h4>声明</h4>
            <ul>
              <li><a href="/about/">透明变现</a></li>
              <li><a href="/about/">联系我们</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <p>本站部分链接为联盟链接，购买不会增加你的花费，但可能为我们带来佣金，感谢支持。</p>
          <p>© {new Date().getFullYear()} macmp.com · Apple 与 macOS 是 Apple Inc. 的商标。</p>
        </div>
      </div>
    </footer>
  </body>
</html>
