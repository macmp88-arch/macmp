---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { faqItems, faqCategories } from '../../data/faq';

const title = 'Mac 常见问题与解决方法 · 故障排查手册 · MacMP';
const description =
  'Mac 磁盘空间不足、发烫卡顿、连不上 Wi-Fi、时间机器备份失败、系统数据过大、应用打不开等常见问题的完整排查步骤，每条都给出可直接执行的命令与预防方法。';

const grouped = faqCategories.map((cat) => ({
  ...cat,
  items: faqItems.filter((item) => item.category === cat.key),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Mac 常见问题与解决方法',
  description,
  url: new URL('/faq/', Astro.site).toString(),
  hasPart: faqItems.slice(0, 12).map((item) => ({
    '@type': 'Article',
    headline: item.title,
    url: new URL(`/faq/${item.slug}/`, Astro.site).toString(),
  })),
};
---

<BaseLayout title={title} description={description} path="/faq">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <section class="faq-hero">
    <div class="container">
      <p class="eyebrow">Mac 问题排查</p>
      <h1>Mac 出问题了？<br />先按顺序排查，别急着重装。</h1>
      <p>
        日常使用中最容易遇到的 {faqItems.length} 类问题，每一类都按「症状 → 原因 → 快速修复 → 分步处理 → 预防」写清楚。
        能一条命令解决的，就不让你去搜十篇文章。
      </p>
      <div class="faq-search">
        <input type="search" id="faqSearch" placeholder="搜索问题，例如：磁盘满、发烫、连不上 WiFi…" autocomplete="off" />
      </div>
      <div class="hero-meta">
        <span><strong>{faqItems.length}</strong> 条排查手册</span>
        <span><strong>{faqCategories.length}</strong> 个分类</span>
        <span>持续更新</span>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="faq-filters" id="faqFilters">
      <button class="filter-chip active" data-cat="all">全部</button>
      {faqCategories.map((cat) => (
        <button class="filter-chip" data-cat={cat.key}>{cat.icon} {cat.title}</button>
      ))}
    </div>

    <p class="faq-empty" id="faqEmpty" hidden>没有匹配的问题。试试更短的关键词，比如「磁盘」「蓝牙」「摄像头」。</p>

    {grouped.map((group) => (
      <section class="faq-group" data-group={group.key}>
        <div class="faq-group-head">
          <h2><span class="faq-icon">{group.icon}</span>{group.title}</h2>
          <span class="faq-count">{group.items.length} 条</span>
        </div>
        <div class="faq-grid">
          {group.items.map((item) => (
            <article
              class="faq-card"
              data-search={`${item.title} ${item.question} ${item.tags.join(' ')} ${item.summary}`.toLowerCase()}
              data-cat={group.key}
            >
              <a class="faq-card-link" href={`/faq/${item.slug}/`}>
                <div class="faq-card-top">
                  <span class={`sev sev-${item.severity}`}>{item.severity}</span>
                  <span class="faq-card-tags">{item.tags.slice(0, 3).join(' · ')}</span>
                </div>
                <h3>{item.question}</h3>
                <p>{item.summary}</p>
                <span class="faq-go">查看排查步骤 →</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="faq-note">
      <h2>排查的通用原则</h2>
      <ol>
        <li><strong>先备份再动手</strong>：任何涉及磁盘、系统、密码的操作之前，先确认有时间机器备份。</li>
        <li><strong>从最简单的开始</strong>：重启、换线、忘记网络重连，这三招能解决相当一部分问题。</li>
        <li><strong>一次只改一个变量</strong>：同时改五处设置，出问题就不知道是哪一步导致的。</li>
        <li><strong>不要盲目全局关闭安全功能</strong>：Gatekeeper、SIP、FileVault 都是保护你的，别为了方便长期关掉。</li>
        <li><strong>记下你做过什么</strong>：改过哪些设置、跑过哪些命令，出问题时能快速回退。</li>
      </ol>
    </section>
  </div>

  <script>
    const search = document.getElementById('faqSearch') as HTMLInputElement | null;
    const filters = document.getElementById('faqFilters');
    const empty = document.getElementById('faqEmpty');
    const groups = Array.from(document.querySelectorAll<HTMLElement>('.faq-group'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.faq-card'));
    let activeCat = 'all';

    function apply() {
      const q = (search?.value || '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const matchText = !q || (card.dataset.search || '').includes(q);
        const matchCat = activeCat === 'all' || card.dataset.cat === activeCat;
        const show = matchText && matchCat;
        card.hidden = !show;
        if (show) visible += 1;
      });
      groups.forEach((group) => {
        const any = Array.from(group.querySelectorAll<HTMLElement>('.faq-card')).some((c) => !c.hidden);
        group.hidden = !any;
      });
      if (empty) empty.hidden = visible > 0;
    }

    filters?.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-chip');
      if (!target) return;
      activeCat = target.dataset.cat || 'all';
      filters.querySelectorAll('.filter-chip').forEach((chip) => chip.classList.remove('active'));
      target.classList.add('active');
      apply();
    });

    search?.addEventListener('input', apply);
  </script>
</BaseLayout>

<style>
  .faq-hero { padding: 64px 0 34px; background: radial-gradient(circle at 80% 10%, rgba(0,113,227,.13), transparent 44%), linear-gradient(150deg,#f7fbff,#fff 58%,#eef5ff); border-bottom: 1px solid #e4e8f0; }
  .faq-hero h1 { font-size: clamp(34px, 4.6vw, 54px); line-height: 1.12; letter-spacing: -.03em; margin: 10px 0 16px; }
  .faq-hero p { font-size: 17px; line-height: 1.85; color: #475467; max-width: 780px; }
  .faq-search { margin: 22px 0 6px; max-width: 560px; }
  .faq-search input { width: 100%; padding: 14px 20px; font-size: 16px; border: 1px solid #d7dde8; border-radius: 980px; outline: none; background: #fff; }
  .faq-search input:focus { border-color: #0071e3; box-shadow: 0 0 0 4px rgba(0,113,227,.12); }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 18px; color: #667085; font-size: 14px; }
  .faq-filters { display: flex; flex-wrap: wrap; gap: 9px; margin: 34px 0 8px; }
  .filter-chip { padding: 9px 17px; border: 1px solid #d7dde8; border-radius: 999px; background: #fff; color: #344054; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .16s; }
  .filter-chip:hover { border-color: #0071e3; color: #0071e3; }
  .filter-chip.active { background: #0071e3; border-color: #0071e3; color: #fff; }
  .faq-empty { margin: 20px 0; padding: 16px 20px; background: #fff8e6; border: 1px solid #ffe1a8; border-radius: 12px; color: #8a5a00; font-size: 14px; }
  .faq-group { margin: 34px 0; }
  .faq-group-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 14px; }
  .faq-group-head h2 { display: flex; align-items: center; gap: 9px; font-size: 23px; margin: 0; letter-spacing: -.01em; }
  .faq-icon { font-size: 20px; }
  .faq-count { color: #98a2b3; font-size: 13px; }
  .faq-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 14px; }
  .faq-card { border: 1px solid #e4e8f0; border-radius: 18px; background: #fff; transition: border-color .18s, box-shadow .18s, transform .18s; }
  .faq-card:hover { border-color: #0071e3; box-shadow: 0 16px 36px rgba(0,113,227,.10); transform: translateY(-2px); }
  .faq-card-link { display: grid; gap: 9px; padding: 20px; text-decoration: none; color: inherit; }
  .faq-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .sev { padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
  .sev-常见 { background: #e8f2ff; color: #0071e3; }
  .sev-中等 { background: #fff4e5; color: #b45309; }
  .sev-严重 { background: #fdecec; color: #c0392b; }
  .faq-card-tags { color: #98a2b3; font-size: 12.5px; }
  .faq-card h3 { margin: 0; font-size: 17px; line-height: 1.5; color: #172033; }
  .faq-card p { margin: 0; color: #475467; font-size: 14px; line-height: 1.72; }
  .faq-go { color: #0071e3; font-size: 13.5px; font-weight: 600; }
  .faq-note { margin: 46px 0; padding: 26px; border: 1px solid #e4e8f0; border-radius: 22px; background: #f9fbfe; }
  .faq-note h2 { margin-top: 0; font-size: 22px; }
  .faq-note ol { margin: 0; padding-left: 20px; color: #475467; font-size: 15px; line-height: 1.95; }
  @media (max-width: 640px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
