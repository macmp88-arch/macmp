---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps } from '../data/apps';
import Newsletter from '../components/Newsletter.astro';
import Donate from '../components/Donate.astro';

const gradientMap: Record<string, string> = {
  setapp: 'linear-gradient(145deg, #1d1d1f 0%, #3c3c40 100%)',
  'cleanmymac-x': 'linear-gradient(145deg, #0071e3 0%, #40a0ff 100%)',
  raycast: 'linear-gradient(145deg, #ff375f 0%, #ff7a59 100%)',
  crossover: 'linear-gradient(145deg, #0a84ff 0%, #5ac8fa 100%)',
  'bartender-5': 'linear-gradient(145deg, #30d158 0%, #5fd9a0 100%)',
  magnet: 'linear-gradient(145deg, #5e5ce6 0%, #7d7aff 100%)',
};

const featured = apps.slice(0, 6);
---
<BaseLayout path="/">
  <section class="hero">
    <p class="eyebrow"><span class="zh">全新出发 · 只推正版</span><span class="en">Official apps only</span></p>
    <h1>MacMP</h1>
    <p class="sub"><span class="zh">发现好用的 Mac 软件与优惠。</span><span class="en">Discover the best Mac apps and deals.</span></p>
    <div class="hero-links">
      <a href="/software/"><span class="zh">浏览软件推荐</span><span class="en">Browse software</span></a>
      <a href="/ai-local/"><span class="zh">了解本地 AI</span><span class="en">Local AI</span></a>
    </div>
  </section>

  <section class="container" style="padding-top:8px">
    <div class="tile" style="background: linear-gradient(145deg,#000 0%,#2b2b2e 100%); min-height:460px">
      <img class="app-icon-lg" src="/images/apps/setapp.png" alt="Setapp" width="72" height="72" />
      <p class="tile-eyebrow"><span class="zh">订阅合集</span><span class="en">Subscription Bundle</span></p>
      <h3><span class="zh">一个订阅，畅用 240+ 款应用。</span><span class="en">240+ apps. One subscription.</span></h3>
      <p><span class="zh">Setapp 汇集 CleanMyMac X、Ulysses、MindNode 等精选正版应用，重度用户比单独购买更划算。</span><span class="en">Setapp brings together CleanMyMac X, Ulysses, MindNode and more — cheaper than buying each app separately.</span></p>
      <div class="tile-links">
        <a href="/software/setapp/"><span class="zh">了解更多</span><span class="en">Learn more</span></a>
        <a href="https://setapp.com/?ref=YOUR_ID" rel="nofollow sponsored" target="_blank"><span class="zh">前往试用</span><span class="en">Try it</span></a>
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2><span class="zh">精选软件</span><span class="en">Featured Apps</span></h2>
      <a href="/software/"><span class="zh">查看全部</span><span class="en">View all</span></a>
    </div>
    <div class="tiles">
      {featured.map((app) => (
        <a href={`/software/${app.slug}/`} class="tile" style={`background: ${gradientMap[app.slug] ?? 'linear-gradient(145deg,#333,#555)'}`}>
          <img class="app-icon-lg" src={`/images/apps/${app.slug}.png`} alt={app.name} width="72" height="72" />
          <p class="tile-eyebrow"><span class="zh">{app.category}</span><span class="en">{app.categoryEn}</span></p>
          <h3><span class="zh">{app.name}</span><span class="en">{app.nameEn}</span></h3>
          <p><span class="zh">{app.tagline}</span><span class="en">{app.taglineEn}</span></p>
          <span class="tile-links"><span><span class="zh">了解更多</span><span class="en">Learn more</span></span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="container inner">
      <p class="eyebrow">本地 AI</p>
      <h2><span class="zh">在 Mac 上跑通大模型。</span><span class="en">Run AI models on your Mac.</span></h2>
      <p><span class="zh">从 Ollama 入门到本地知识库，一步步把 Apple Silicon 的算力变成你的私人 AI。</span><span class="en">From Ollama basics to a local knowledge base — turn your Apple Silicon into a private AI.</span></p>
      <div class="links">
        <a href="/ai-local/"><span class="zh">阅读教程</span><span class="en">Read tutorials</span></a>
      </div>
    </div>
  </section>

  <div class="container">
    <Donate />
    <Newsletter />
  </div>
</BaseLayout>
