---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps } from '../data/apps';
import { ownAppProfiles } from '../data/ownAppProfiles';
import { guides } from '../data/guides';
import { affiliates } from '../data/affiliates';
import Newsletter from '../components/Newsletter.astro';
import Donate from '../components/Donate.astro';
import Recommendation from '../components/Recommendation.astro';
import Contact from '../components/Contact.astro';

const categories = [
  { zh: '办公', en: 'Productivity', href: '/software/?type=办公' },
  { zh: '媒体', en: 'Media', href: '/software/?type=媒体' },
  { zh: '系统', en: 'System', href: '/software/?type=系统' },
  { zh: '开发', en: 'Developer', href: '/software/?type=开发' },
  { zh: '工具', en: 'Utilities', href: '/software/?type=工具' },
  { zh: '教程', en: 'Tutorials', href: '/ai-local/' },
];

const ownApps = apps.filter((app) => app.isOwnApp);
const directory = apps.slice(0, 24);
const featuredGuides = guides.filter((guide) => guide.featured).slice(0, 4);
const memberEnabled = import.meta.env.PUBLIC_MEMBER_ENABLED === 'true';
---
<BaseLayout path="/">
  <section class="home-stage">
    <div class="container home-stage-inner">
      <div class="home-stage-copy">
        <p class="home-eyebrow">MACMP · FOR CREATORS & PHOTOGRAPHERS</p>
        <h1>把 Mac 和移动设备，变成真正可靠的生产工具。</h1>
        <p class="home-stage-lead">精选正版软件、原创工作流和三款 MacMP 自研工具。我们不堆功能，而是围绕存储、恢复和现场拍摄，把问题一层层解决。</p>
        <div class="home-stage-actions">
          <a class="home-action-primary" href="/apps/">探索 MacMP Apps <span>→</span></a>
          <a class="home-action-secondary" href="/software/">浏览软件目录</a>
        </div>
        <div class="home-stage-proof">
          <span><strong>{apps.length}</strong> 款精选软件</span>
          <span><strong>{guides.length}</strong> 篇原创指南</span>
          <span><strong>{ownApps.length}</strong> 款自研产品</span>
        </div>
      </div>

      <div class="home-product-stack" aria-label="MacMP 自研工具">
        {ownApps.map((app, index) => {
          const profile = ownAppProfiles[app.slug];
          return (
            <a class={`home-stack-card home-stack-card-${index + 1}`} href={`/apps/${app.slug}/`} style={`--accent:${profile.accent};--accent-2:${profile.accent2};--product-dark:${profile.dark}`}>
              <img src={app.heroImage} alt={`${app.name} 产品界面`} width="1600" height="900" loading={index === 0 ? 'eager' : 'lazy'} />
              <span class="home-stack-meta">
                <img src={`/images/apps/${app.slug}.png`} alt="" width="42" height="42" />
                <span><strong>{app.name}</strong><small>{profile.status} · {profile.platform}</small></span>
                <em>↗</em>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="container home-trust-strip">
    <div><span class="trust-icon">⌘</span><strong>原生体验</strong><small>Intel 与 Apple Silicon</small></div>
    <div><span class="trust-icon">◌</span><strong>本地优先</strong><small>减少不必要的数据上传</small></div>
    <div><span class="trust-icon">◒</span><strong>创作者视角</strong><small>摄影师、剪辑师与旅行创作者</small></div>
    <div><span class="trust-icon">↗</span><strong>持续更新</strong><small>产品、指南与工具一起迭代</small></div>
  </section>

  <section class="section container home-products">
    <div class="section-head home-section-head">
      <div><p class="home-section-kicker">MACMP APPS</p><h2>三款产品，一条清晰的生产力主线。</h2></div>
      <a href="/apps/">查看全部产品 →</a>
    </div>
    <div class="official-app-grid">
      {ownApps.map((app) => {
        const profile = ownAppProfiles[app.slug];
        return (
          <a class="official-app-card" href={`/apps/${app.slug}/`} style={`--accent:${profile.accent};--accent-2:${profile.accent2};--accent-soft:${profile.accentSoft};--product-dark:${profile.dark}`}>
            <span class="official-app-media">
              <img src={app.heroImage} alt={`${app.name} 产品界面`} width="1600" height="900" loading="lazy" />
              <small><i></i>{profile.status}</small>
            </span>
            <span class="official-app-copy">
              <span class="official-app-title">
                <img src={`/images/apps/${app.slug}.png`} alt="" width="50" height="50" />
                <span><strong>{app.name}</strong><small>{profile.platform}</small></span>
              </span>
              <span class="official-app-desc">{app.tagline}</span>
              <span class="official-app-points">{profile.highlights.slice(0, 3).map((item) => <span>{item}</span>)}</span>
              <span class="official-app-link">打开官方产品页 <strong>→</strong></span>
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="container home-categories">
    <span class="home-categories-label">继续浏览</span>
    <div class="home-category-list">
      {categories.map((c) => <a href={c.href}><span>{c.zh}</span><small>{c.en}</small><em>→</em></a>)}
      <a href="/sound-effects/"><span>免费音效</span><small>SFX & Music</small><em>→</em></a>
      <a href="/gold/"><span>黄金行情</span><small>Gold & Macro</small><em>→</em></a>
    </div>
  </section>

  <!-- 软件目录 -->
  <section class="section container">
    <div class="section-head">
      <h2><span class="zh">软件目录</span><span class="en">Software Directory</span></h2>
      <a href="/software/"><span class="zh">全部 {apps.length} 款 →</span><span class="en">All {apps.length} apps →</span></a>
    </div>
    <div class="dir-grid">
      {directory.map((app) => (
        <a class="dir-card" href={app.isOwnApp ? `/apps/${app.slug}/` : `/software/${app.slug}/`}>
          <img class="app-icon" src={`/images/apps/${app.slug}.png`} alt={app.name} width="48" height="48" loading="lazy" />
          <span class="dir-body">
            <strong><span class="zh">{app.name}</span><span class="en">{app.nameEn}</span></strong>
            <span class="dir-tag"><span class="zh">{app.category}</span><span class="en">{app.categoryEn}</span> · {app.price}</span>
          </span>
          <span class="dir-go"><span class="zh">了解 →</span><span class="en">View →</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- VIP 会员 -->
  {memberEnabled && (
    <section class="container" style="padding-top:42px">
      <div class="tile vip-tile" style="background: linear-gradient(135deg,#071a33 0%,#0b66c3 58%,#56b4ff 100%); min-height:310px">
        <p class="tile-eyebrow"><span class="zh">MacMP VIP</span><span class="en">MacMP VIP</span></p>
        <h3><span class="zh">把内容变成可下载、可复用的工作流。</span><span class="en">Turn guides into reusable workflows.</span></h3>
        <p><span class="zh">邮箱注册后，可选择国内扫码支付或 PayPal 美元支付，获取模板、工程文件、软件优惠情报和后续新增资料。</span><span class="en">Register by email, pay with WeChat/Alipay or PayPal, and unlock templates, project files and ongoing resources.</span></p>
        <div class="tile-links">
          <a href="/vip/"><span class="zh">查看会员方案</span><span class="en">View membership</span></a>
        </div>
      </div>
    </section>
  )}

  <!-- 专题指南 -->
  <section class="section container">
    <div class="section-head">
      <h2><span class="zh">专题指南</span><span class="en">Guides & Workflows</span></h2>
      <a href="/guides/"><span class="zh">全部 {guides.length} 篇 →</span><span class="en">All {guides.length} guides →</span></a>
    </div>
    <div class="guide-grid">
      {featuredGuides.map((guide) => (
        <article class="guide-card">
          <a class="guide-cover-link" href={`/guides/${guide.slug}/`}>
            <img src={guide.cover} alt="" width="1200" height="675" loading="lazy" />
          </a>
          <div class="guide-card-body">
            <span class="cat">{guide.category}</span>
            <h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3>
            <p>{guide.summary}</p>
            <div class="meta"><span>{guide.readTime}</span><span>{guide.tags[0]}</span></div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 免费素材与工具 -->
  <section class="section container">
    <div class="section-head">
      <h2><span class="zh">免费素材与工具</span><span class="en">Free Assets & Tools</span></h2>
      <a href="/tools/"><span class="zh">全部资源 →</span><span class="en">All resources →</span></a>
    </div>
    <div class="asset-grid">
      <a class="asset-card" href="https://www.ysjf.com/material" target="_blank" rel="noopener">
        <span class="asset-tag">免费素材</span>
        <strong><span class="zh">影视飓风 · 素材库</span><span class="en">MediaStorm · Footage Library</span></strong>
        <span class="asset-desc"><span class="zh">航拍、空镜、特效与转场素材，可免费下载，剪辑补画面首选。</span><span class="en">Free aerial, insert, VFX and transition footage — first stop when a cut needs another shot.</span></span>
        <span class="asset-go"><span class="zh">前往素材库 →</span><span class="en">Open library →</span></span>
      </a>
      <a class="asset-card" href="/tools/lut/">
        <span class="asset-tag">本站工具</span>
        <strong><span class="zh">在线 LUT 生成器</span><span class="en">Online LUT Generator</span></strong>
        <span class="asset-desc"><span class="zh">上传原片截图 + 参考图，生成 DaVinci / FCPX / PR 通用的 .cube LUT。</span><span class="en">Upload a frame plus a reference and export a .cube LUT for DaVinci, FCPX or Premiere.</span></span>
        <span class="asset-go"><span class="zh">打开工具 →</span><span class="en">Open tool →</span></span>
      </a>
      <a class="asset-card" href="/sound-effects/">
        <span class="asset-tag">音频素材</span>
        <strong><span class="zh">免费音效与音乐库</span><span class="en">Free SFX & Music Library</span></strong>
        <span class="asset-desc"><span class="zh">转场、婚礼、短剧、玄幻、Foley 和环境音，按用途分类并标注授权，直达原始下载页。</span><span class="en">Transitions, wedding, short drama, fantasy, Foley and ambience — organised by use with licence notes and direct download links.</span></span>
        <span class="asset-go"><span class="zh">打开音效库 →</span><span class="en">Open SFX library →</span></span>
      </a>
    </div>
  </section>

  <!-- 黄金与宏观资讯 -->
  <section class="section container">
    <div class="section-head">
      <h2><span class="zh">黄金与宏观资讯</span><span class="en">Gold & Macro</span></h2>
      <a href="/gold/"><span class="zh">进入栏目 →</span><span class="en">Open page →</span></a>
    </div>
    <div class="asset-grid">
      <a class="asset-card gold-card" href="/gold/#market">
        <span class="asset-tag gold-tag">多周期 K 线</span>
        <strong><span class="zh">伦敦金行情入口</span><span class="en">XAU/USD Market</span></strong>
        <span class="asset-desc"><span class="zh">查看 5 分钟、15 分钟、1 小时、4 小时、日线和月线 K 线，以及利率与宏观事件入口。行情是否实时取决于数据源，不构成投资建议。</span><span class="en">View XAU/USD charts from 5 minutes to monthly, plus macro sources. Data latency depends on the provider; not investment advice.</span></span>
        <span class="asset-go"><span class="zh">查看行情 →</span><span class="en">View market →</span></span>
      </a>
      <a class="asset-card gold-card" href="/gold/#sources">
        <span class="asset-tag gold-tag">官方来源</span>
        <strong><span class="zh">美联储与白宫资讯</span><span class="en">Fed & White House</span></strong>
        <span class="asset-desc"><span class="zh">直达美联储、白宫、财政部、BLS、CFTC、LBMA 和黄金 ETF 原始页面。</span><span class="en">Direct links to the Fed, White House, Treasury, BLS, CFTC, LBMA and gold ETF sources.</span></span>
        <span class="asset-go"><span class="zh">打开来源 →</span><span class="en">Open sources →</span></span>
      </a>
    </div>
  </section>

  <!-- Setapp 主推 -->
  <section class="container" style="padding-top:8px">
    <div class="tile" style="background: linear-gradient(145deg,#000 0%,#2b2b2e 100%); min-height:380px">
      <img class="app-icon-lg" src="/images/apps/setapp.png" alt="Setapp" width="72" height="72" />
      <p class="tile-eyebrow"><span class="zh">订阅合集</span><span class="en">Subscription Bundle</span></p>
      <h3><span class="zh">一个订阅，畅用 240+ 款应用。</span><span class="en">240+ apps. One subscription.</span></h3>
      <p><span class="zh">Setapp 汇集 CleanMyMac X、Ulysses、MindNode 等精选正版应用，重度用户比单独购买更划算。</span><span class="en">Setapp brings together CleanMyMac X, Ulysses, MindNode and more — cheaper than buying each separately.</span></p>
      <div class="tile-links">
        <a href="/software/setapp/"><span class="zh">了解更多</span><span class="en">Learn more</span></a>
        <a href={affiliates.setapp.url} rel="nofollow sponsored" target="_blank"><span class="zh">前往试用</span><span class="en">Try it</span></a>
      </div>
    </div>
  </section>

  <section class="section container">
    <Recommendation />
  </section>

  <section class="band">
    <div class="container inner">
      <p class="eyebrow">本地 AI</p>
      <h2><span class="zh">在 Mac 上跑通大模型。</span><span class="en">Run AI models on your Mac.</span></h2>
      <p><span class="zh">从 Ollama 入门到本地知识库，一步步把 Apple Silicon 的算力变成你的私人 AI。</span><span class="en">From Ollama basics to a local knowledge base — turn your Apple Silicon into a private AI.</span></p>
      <div class="links">
        <a href="/ai-local/"><span class="zh">阅读教程</span><span class="en">Read tutorials</span></a>
      </div>
    </div>
  </section>

  <div class="container">
    <Contact />
    <Donate />
    <Newsletter />
  </div>
</BaseLayout>

<style>
  .hero-search {
    display: flex;
    justify-content: center;
    gap: 8px;
    max-width: 460px;
    margin: 18px auto 0;
  }
  .hero-search input {
    flex: 1;
    padding: 12px 18px;
    font-size: 16px;
    border: 1px solid var(--border);
    border-radius: 980px;
    outline: none;
    background: #fff;
  }
  .hero-search input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(0,113,227,.12); }
  .hero-search button {
    padding: 12px 24px;
    border: 0;
    border-radius: 980px;
    background: var(--blue);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .hero-search button:hover { background: var(--blue-hover); }
  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    padding: 12px 0 8px;
  }
  .cat-nav-item {
    padding: 9px 20px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }
  .cat-nav-item:hover { border-color: var(--blue); color: var(--blue); text-decoration: none; }
  .dir-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }
  .dir-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 12px 14px;
    color: var(--ink);
    transition: border-color .15s ease, transform .15s ease;
  }
  .dir-card:hover { border-color: var(--blue); transform: translateY(-2px); text-decoration: none; }
  .dir-body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .dir-body strong { font-size: 15px; }
  .dir-tag { font-size: 12px; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dir-go { font-size: 13px; color: var(--blue); font-weight: 600; white-space: nowrap; }
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 14px;
  }
  .asset-card {
    display: grid;
    gap: 6px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: linear-gradient(150deg,#f7fbff,#fff 62%,#eef5ff);
    color: var(--ink);
    transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .asset-card:hover { border-color: var(--blue); transform: translateY(-2px); box-shadow: 0 14px 34px rgba(0,113,227,.10); text-decoration: none; }
  .asset-tag { justify-self: start; padding: 3px 10px; border-radius: 999px; background: #e8f2ff; color: var(--blue); font-size: 12px; font-weight: 700; }
  .asset-card strong { font-size: 18px; }
  .asset-desc { font-size: 14px; line-height: 1.7; color: var(--ink-2); }
  .asset-go { margin-top: 4px; font-size: 13.5px; font-weight: 600; color: var(--blue); }
  .asset-card.gold-card { background: linear-gradient(150deg,#fffdf7,#fff 62%,#f6faff); }
  .asset-tag.gold-tag { background: #fff3cf; color: #9a6700; }


  .own-product-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  .own-product-card { overflow:hidden; border:1px solid var(--border); border-radius:24px; background:#fff; color:var(--ink); transition:transform .2s ease, box-shadow .2s ease; }
  .own-product-card:hover { transform:translateY(-4px); box-shadow:0 20px 50px rgba(15,23,42,.13); text-decoration:none; }
  .own-product-card > img { width:100%; aspect-ratio:16/9; object-fit:cover; background:#07111f; }
  .own-product-body { display:flex; align-items:center; gap:12px; padding:16px; }
  .own-product-body > span:nth-child(2) { display:flex; flex-direction:column; gap:4px; min-width:0; flex:1; }
  .own-product-body strong { font-size:17px; }
  .own-product-body small { color:var(--ink-2); font-size:12px; line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .own-product-go { color:var(--blue); font-size:20px; font-weight:700; }
  @media (max-width:900px) { .own-product-grid { grid-template-columns:1fr; } }

  /* ---------- 首页统一产品视觉 ---------- */
  .home-stage { position:relative; overflow:hidden; padding:72px 0 58px; background:linear-gradient(145deg,#f7fbff 0%,#fff 48%,#f3f7fd 100%); border-bottom:1px solid #e7ebf1; }
  .home-stage::before { content:''; position:absolute; width:700px; height:700px; left:-280px; top:-340px; border-radius:50%; background:radial-gradient(circle,rgba(10,132,255,.13),transparent 68%); }
  .home-stage::after { content:''; position:absolute; width:600px; height:600px; right:-250px; bottom:-340px; border-radius:50%; background:radial-gradient(circle,rgba(0,199,190,.10),transparent 68%); }
  .home-stage-inner { position:relative; z-index:1; display:grid; grid-template-columns:.82fr 1.18fr; align-items:center; gap:70px; min-height:610px; }
  .home-stage-copy { max-width:560px; min-width:0; }.home-eyebrow,.home-section-kicker { color:#0a84ff; font:800 11px/1.2 'SFMono-Regular',Menlo,monospace; letter-spacing:.14em; }
  .home-stage-copy h1 { overflow-wrap:anywhere; word-break:break-word; margin:23px 0 20px; color:#10141b; font-size:clamp(42px,5.2vw,68px); line-height:1.04; letter-spacing:-.06em; }
  .home-stage-lead { margin:0; color:#5f6b7a; font-size:17px; line-height:1.85; }
  .home-stage-actions { display:flex; flex-wrap:wrap; gap:11px; margin-top:30px; }.home-action-primary,.home-action-secondary { display:inline-flex; align-items:center; gap:10px; min-height:49px; padding:0 23px; border-radius:999px; font-size:14px; font-weight:750; transition:transform .18s ease,box-shadow .18s ease; }
  .home-action-primary { background:#0a84ff; color:#fff; box-shadow:0 14px 26px rgba(10,132,255,.22); }.home-action-primary:hover { transform:translateY(-2px); color:#fff; text-decoration:none; box-shadow:0 18px 34px rgba(10,132,255,.28); }.home-action-secondary { border:1px solid #d9e0e9; background:#fff; color:#435061; }.home-action-secondary:hover { transform:translateY(-2px); border-color:#0a84ff; color:#0a84ff; text-decoration:none; }
  .home-stage-proof { display:flex; flex-wrap:wrap; gap:12px 24px; margin-top:30px; color:#87909d; font-size:12px; }.home-stage-proof span { display:flex; align-items:baseline; gap:5px; }.home-stage-proof strong { color:#242c38; font-size:16px; }
  .home-product-stack { position:relative; height:540px; min-width:0; overflow:hidden; }.home-stack-card { position:absolute; display:block; overflow:hidden; border:1px solid rgba(255,255,255,.8); border-radius:24px; background:#0b111a; box-shadow:0 32px 70px rgba(18,29,50,.20); transition:transform .3s ease,box-shadow .3s ease; }.home-stack-card:hover { text-decoration:none; box-shadow:0 38px 82px rgba(18,29,50,.26); }.home-stack-card img { display:block; width:100%; height:auto; }.home-stack-card-1 { z-index:3; left:8%; top:75px; width:73%; transform:rotate(-4deg); }.home-stack-card-2 { z-index:2; right:0; top:190px; width:65%; transform:rotate(4deg); }.home-stack-card-3 { z-index:1; left:0; bottom:0; width:61%; transform:rotate(-1deg); }.home-stack-card-1:hover { transform:rotate(-2deg) translateY(-7px); }.home-stack-card-2:hover { transform:rotate(2deg) translateY(-7px); }.home-stack-card-3:hover { transform:rotate(0) translateY(-7px); }
