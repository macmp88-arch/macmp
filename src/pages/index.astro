---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps } from '../data/apps';
import Newsletter from '../components/Newsletter.astro';
import Donate from '../components/Donate.astro';

const gradientMap: Record<string, string> = {
  setapp: 'linear-gradient(145deg, #1d1d1f 0%, #3c3c40 100%)',
  'cleanmymac-x': 'linear-gradient(145deg, #0071e3 0%, #40a0ff 100%)',
  raycast: 'linear-gradient(145deg, #ff375f 0%, #ff7a59 100%)',
  crossover: 'linear-gradient(145deg, #0a84ff 0%, #5ac8fa 100%)',
  'bartender-5': 'linear-gradient(145deg, #30d158 0%, #5fd9a0 100%)',
  magnet: 'linear-gradient(145deg, #5e5ce6 0%, #7d7aff 100%)',
};

const featured = apps.slice(0, 6);
---
<BaseLayout path="/">
  <!-- Hero -->
  <section class="hero">
    <p class="eyebrow">全新出发 · 只推正版</p>
    <h1>MacMP</h1>
    <p class="sub">发现好用的 Mac 软件与优惠。</p>
    <div class="hero-links">
      <a href="/software/">浏览软件推荐</a>
      <a href="/ai-local/">了解本地 AI</a>
    </div>
  </section>

  <!-- 主视觉：Setapp 大卡片 -->
  <section class="container" style="padding-top:8px">
    <div class="tile" style="background: linear-gradient(145deg,#000 0%,#2b2b2e 100%); min-height:460px">
      <p class="tile-eyebrow">订阅合集</p>
      <h3>一个订阅，畅用 240+ 款应用。</h3>
      <p>Setapp 汇集 CleanMyMac X、Ulysses、MindNode 等精选正版应用，重度用户比单独购买更划算。</p>
      <div class="tile-links">
        <a href="/software/setapp/">了解更多</a>
        <a href="https://setapp.com/?ref=YOUR_ID" rel="nofollow sponsored" target="_blank">前往试用</a>
      </div>
    </div>
  </section>

  <!-- 精选软件瓷砖 -->
  <section class="section container">
    <div class="section-head">
      <h2>精选软件</h2>
      <a href="/software/">查看全部</a>
    </div>
    <div class="tiles">
      {featured.map((app) => (
        <a
          href={`/software/${app.slug}/`}
          class="tile"
          style={`background: ${gradientMap[app.slug] ?? 'linear-gradient(145deg,#333,#555)'}`}
        >
          <p class="tile-eyebrow">{app.category}</p>
          <h3>{app.name}</h3>
          <p>{app.tagline}</p>
          <span class="tile-links"><span>了解更多</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- 本地 AI 深色区块 -->
  <section class="band">
    <div class="container inner">
      <p class="eyebrow">本地 AI</p>
      <h2>在 Mac 上跑通大模型。</h2>
      <p>从 Ollama 入门到本地知识库，一步步把 Apple Silicon 的算力变成你的私人 AI。</p>
      <div class="links">
        <a href="/ai-local/">阅读教程</a>
      </div>
    </div>
  </section>

  <div class="container">
    <Donate />
    <Newsletter />
  </div>
</BaseLayout>
