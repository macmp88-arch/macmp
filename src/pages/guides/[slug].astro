---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import Newsletter from '../../components/Newsletter.astro';
import Recommendation from '../../components/Recommendation.astro';
import { guides } from '../../data/guides';
import type { Guide } from '../../data/guides';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const related = guides.filter((item) => item.slug !== guide.slug && (item.category === guide.category || item.tags.some((tag) => guide.tags.includes(tag)))).slice(0, 3);
const fallbackRelated = guides.filter((item) => item.slug !== guide.slug).slice(0, 3);
const relatedGuides = related.length >= 2 ? related : fallbackRelated;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.summary,
  datePublished: guide.date,
  dateModified: guide.date,
  image: new URL(guide.cover, Astro.site).toString(),
  author: { '@type': 'Organization', name: 'MacMP' },
  publisher: { '@type': 'Organization', name: 'MacMP', url: Astro.site },
  mainEntityOfPage: new URL(`/guides/${guide.slug}/`, Astro.site).toString(),
};
---
<BaseLayout title={`${guide.title} · MacMP`} description={guide.summary} path={`/guides/${guide.slug}`} image={guide.cover}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <div class="container">
    <nav class="crumbs" aria-label="breadcrumb">
      <a href="/">首页</a><span class="sep">›</span>
      <a href="/guides/">专题指南</a><span class="sep">›</span>
      <span class="current">{guide.category}</span>
    </nav>

    <article class="guide-article">
      <header class="guide-head">
        <p class="eyebrow">{guide.category}</p>
        <h1>{guide.title}</h1>
        <p class="guide-summary">{guide.summary}</p>
        <div class="guide-meta">
          <span>{guide.date}</span>
          <span>{guide.readTime}</span>
          <span>{guide.tags.join(' · ')}</span>
        </div>
      </header>

      <img class="guide-hero-image" src={guide.cover} alt={`${guide.title} 封面`} width="1200" height="675" />

      <div class="guide-opener">
        <p>{guide.intro}</p>
        <div class="takeaways">
          <h2>看完你会得到</h2>
          <ul>
            {guide.takeaways.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="guide-prose">
        {guide.sections.map((section, index) => (
          <section id={`section-${index + 1}`}>
            <h2><span class="section-index">{String(index + 1).padStart(2, '0')}</span>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul>
                {section.bullets.map((item) => <li>{item}</li>)}
              </ul>
            )}
            {section.callout && <div class="callout">{section.callout}</div>}
          </section>
        ))}
      </div>

      {guide.faqs && (
        <section class="guide-faq">
          <h2>常见问题</h2>
          {guide.faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </section>
      )}

      <div class="guide-note">
        <strong>编辑说明：</strong>本文为独立整理的使用方法，不构成任何软件的绝对推荐。价格、功能与系统要求请以软件官网为准；部分购买链接为联盟链接，不会增加你的花费。
      </div>
    </article>

    <Recommendation slugs={guide.relatedApps.slice(0, 4)} titleZh="文中提到的软件" titleEn="Apps in this guide" />

    <section class="related-guides">
      <div class="section-head">
        <h2>继续阅读</h2>
        <a href="/guides/">全部指南 →</a>
      </div>
      <div class="guide-grid compact">
        {relatedGuides.map((item) => (
          <article class="guide-card">
            <a class="guide-cover-link" href={`/guides/${item.slug}/`}>
              <img src={item.cover} alt="" width="1200" height="675" loading="lazy" />
            </a>
            <div class="guide-card-body">
              <span class="cat">{item.category}</span>
              <h3><a href={`/guides/${item.slug}/`}>{item.title}</a></h3>
              <div class="meta"><span>{item.readTime}</span><span>{item.tags[0]}</span></div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <Newsletter />
    <Comments />
  </div>
</BaseLayout>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 22px 0 0; font-size: 13px; color: var(--ink-2); }
  .crumbs a { color: var(--ink-2); }
  .crumbs a:hover { color: var(--blue); }
  .crumbs .sep { color: #c7c7cc; }
  .crumbs .current { color: var(--ink); font-weight: 600; }
  .guide-article { margin: 22px 0 30px; }
  .guide-head { max-width: 900px; padding: 28px 0 22px; }
  .guide-head .eyebrow { color: var(--blue); font-size: 14px; font-weight: 700; letter-spacing: .08em; margin: 0 0 10px; }
  .guide-head h1 { font-size: clamp(36px, 6vw, 62px); line-height: 1.1; letter-spacing: -.035em; margin: 0 0 18px; }
  .guide-summary { color: var(--ink-2); font-size: 19px; line-height: 1.7; margin: 0; }
  .guide-meta { display: flex; flex-wrap: wrap; gap: 10px 22px; color: var(--ink-2); font-size: 13px; margin-top: 18px; }
  .guide-hero-image { width: 100%; aspect-ratio: 16 / 7; object-fit: cover; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-md); }
  .guide-opener { max-width: 820px; margin: 34px auto 8px; font-size: 18px; line-height: 1.85; }
  .guide-opener > p { color: #333; }
  .takeaways { margin-top: 26px; padding: 24px 26px; background: #f0f7ff; border: 1px solid #cfe4ff; border-radius: var(--radius-md); }
  .takeaways h2 { font-size: 18px; margin: 0 0 12px; }
  .takeaways ul { margin: 0; padding-left: 20px; }
  .takeaways li { margin: 8px 0; color: #335; }
  .guide-prose { max-width: 820px; margin: 44px auto; }
  .guide-prose section { scroll-margin-top: 70px; margin: 0 0 46px; }
  .guide-prose h2 { display: flex; gap: 12px; align-items: baseline; font-size: 27px; letter-spacing: -.02em; margin: 0 0 18px; }
  .section-index { color: var(--blue); font-size: 13px; letter-spacing: .06em; }
  .guide-prose p { color: #333; font-size: 17px; line-height: 1.9; margin: 0 0 16px; }
  .guide-prose ul { padding-left: 22px; margin: 10px 0 18px; }
  .guide-prose li { color: #333; font-size: 16px; line-height: 1.8; margin: 7px 0; }
  .callout { margin: 24px 0; padding: 18px 20px; border-left: 4px solid var(--blue); border-radius: 0 12px 12px 0; background: var(--bg-2); color: #333; line-height: 1.75; }
  .guide-faq { max-width: 820px; margin: 50px auto; }
  .guide-faq h2 { font-size: 24px; margin: 0 0 16px; }
  .guide-faq details { border: 1px solid var(--border); border-radius: 14px; margin-bottom: 10px; background: #fff; }
  .guide-faq summary { cursor: pointer; padding: 16px 18px; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  .guide-faq summary::after { content: '+'; color: var(--blue); font-size: 20px; }
  .guide-faq details[open] summary::after { content: '−'; }
  .guide-faq p { padding: 0 18px 16px; margin: 0; color: var(--ink-2); line-height: 1.75; }
  .guide-note { max-width: 820px; margin: 46px auto 0; padding-top: 18px; border-top: 1px solid var(--border); color: var(--ink-2); font-size: 13px; line-height: 1.7; }
  .related-guides { margin-top: 56px; }
  .related-guides .guide-grid { margin-top: 0; }
  @media (max-width: 640px) {
    .guide-head h1 { font-size: 36px; }
    .guide-hero-image { aspect-ratio: 16 / 9; }
    .guide-prose h2 { font-size: 23px; }
    .guide-prose p { font-size: 16px; }
  }
</style>
