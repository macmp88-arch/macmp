---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  soundCategories,
  soundSources,
  soundCategoryCount,
  soundSourceCount,
  soundFreeCommercialCount,
} from '../../data/soundEffects';
import { soundPreviews } from '../../data/soundPreviews';

const title = '免费音效与音乐库导航 · 音频转 MP3 / 婚礼音乐 / 短剧配乐 · MacMP';
const description =
  '按用途整理的免费音效与免版税音乐导航：转场、环境音、婚礼、短剧、玄幻、宣传片、UI、Foley 等；并提供浏览器本地音频转 MP3 工具，文件不上传服务器。';
const path = '/sound-effects';

const licenseStyles: Record<string, string> = {
  可商用: 'lic-ok',
  需署名: 'lic-credit',
  逐条确认: 'lic-mid',
  仅限个人学习: 'lic-study',
};

const filters = ['全部', '音效', '音乐', '氛围', '短剧', '婚礼'];

const previewAudience = (category: string) => {
  if (category === '婚礼') return '婚礼,音乐';
  if (category === '短剧') return '短剧,音效';
  if (category === '氛围') return '氛围';
  return '音效';
};

const waveformPeaks = (peaks: number[]) => peaks.filter((_, index) => index % 2 === 0);

const faqs = [
  {
    q: '为什么能转 WAV、FLAC，却不提供 NCM 或 QQ 加密格式？',
    a: 'NCM、QMC、MGG、MFLAC 等属于平台加密或受保护格式，转换需要移除保护，可能涉及平台条款、著作权与 DRM 问题。本站不提供解密或绕过保护的功能，只支持浏览器能够正常读取的未加密音频；请使用合法来源和未加密母版。',
  },
  {
    q: '为什么不能直接把音频抓到本站提供下载？',
    a: '免费不等于可以重新托管。很多素材站允许你在作品中商用，但不允许把音频文件本身转载、打包或做成竞品素材库。本站采用“来源导航 + 原始下载页”的方式，规避二次分发风险。',
  },
  {
    q: '标注“可商用”就可以完全放心使用吗？',
    a: '不代表完全没有限制。通常仍可能禁止单独转售、禁止用于竞品素材库、禁止用 AI 训练等。使用前要看具体站点的最新许可证，重大商单建议保留授权页面截图。',
  },
  {
    q: 'Freesound 和 Free Music Archive 为什么写“逐条确认”？',
    a: '这两个平台有大量不同作者和不同许可证，同一网站上会同时存在 CC0、CC BY、CC BY-NC 等资源。必须进入单个音频页面查看作者标注的许可证。',
  },
  {
    q: '这一页的婚礼音乐能直接用于商单吗？',
    a: '这些试听来自 Mixkit 官方免版税音乐库，适合婚礼片、宣传片和商业视频项目。本站只做官方试听与下载入口，不重新托管音频；使用前仍应在单曲下载页确认最新 Mixkit Stock Music Free License。',
  },
  {
    q: '婚礼片和短剧最推荐先看哪里？',
    a: '婚礼音乐优先看 Pixabay Music、Mixkit Music、Uppbeat；音效优先看 Mixkit、Pixabay、Freesound；需要大批量建立本地库时，再看 Sonniss GDC 年度音频包。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '免费音效与音乐库导航',
  description,
  numberOfItems: soundSourceCount + soundCategoryCount,
  itemListElement: [
    ...soundCategories.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      description: item.desc,
    })),
    ...soundSources.map((item, index) => ({
      '@type': 'ListItem',
      position: soundCategories.length + index + 1,
      name: item.name,
      url: item.url,
    })),
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout title={title} description={description} path={path}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="sfx-hero">
    <div class="container">
      <p class="eyebrow">免费音效与音乐</p>
      <h1>找声音，不要再翻十个网站。</h1>
      <p class="hero-lead">
        精选适合婚礼正片的钢琴、弦乐、竖琴与回忆氛围音乐。
        在线试听、按段落使用，下载直达 Mixkit 官方授权页面，不二次托管音频。
        常用未加密音频也可以直接在浏览器里转换成 MP3，文件不会上传。
      </p>
      <div class="hero-actions">
        <a class="hero-btn primary" href="#categories">按用途找音效 →</a>
        <a class="hero-btn" href="#audio-converter">音频转 MP3 →</a>
        <a class="hero-btn" href="#sources">看免版税来源 →</a>
        <a class="hero-btn" href="https://mixkit.co/free-sound-effects/" target="_blank" rel="noopener">打开 Mixkit →</a>
      </div>
      <div class="hero-meta">
        <span><strong>{soundCategoryCount}</strong> 个剪辑用途分类</span>
        <span><strong>{soundSourceCount}</strong> 个免费来源</span>
        <span><strong>{soundFreeCommercialCount}</strong> 个标注可商用</span>
        <span><strong>{soundPreviews.length}</strong> 首婚礼配乐</span>
      </div>
    </div>
  </section>

  <div class="container sfx-shell">
    <div class="notice">
      <strong>本站不重新托管音频</strong>
      <p>
        “免费下载”指跳转到 Mixkit、Pixabay、Freesound 等原始授权页面下载。
        不要因为一首歌写着 Free 就直接拿去做商单，先确认是 CC0、CC BY、平台免费许可，还是仅限个人学习。
      </p>
    </div>

    <section class="search-panel" aria-label="搜索音效">
      <div class="search-box">
        <span aria-hidden="true">🔎</span>
        <input id="sfxSearch" type="search" placeholder="搜索：转场、婚礼、雨声、短剧、Foley、魔法…" autocomplete="off" />
      </div>
      <div class="filter-row" id="sfxFilters">
        {filters.map((filter, index) => (
          <button type="button" class={`filter-chip${index === 0 ? ' active' : ''}`} data-filter={filter} aria-pressed={index === 0 ? 'true' : 'false'}>
            {filter}
          </button>
        ))}
        <span class="result-count" id="sfxCount">当前显示 {soundCategoryCount + soundSourceCount} 个结果</span>
      </div>
    </section>

    <section class="sfx-section audio-converter" id="audio-converter" aria-labelledby="audioConverterTitle">
      <div class="section-head-sfx">
        <div>
          <span class="section-tag">本地音频转 MP3</span>
          <h2 id="audioConverterTitle">常用音频一键转 MP3，文件不上传</h2>
        </div>
        <p>支持浏览器可正常解码的未加密音频。转换全部在当前设备完成，最高输出 320 kbps，适合剪辑前整理素材。</p>
      </div>

      <div class="audio-converter-shell">
        <div class="audio-converter-topline">
          <div>
            <span class="audio-converter-kicker">PRIVATE AUDIO TOOL</span>
            <h3>把零散音频整理成通用 MP3</h3>
            <p>WAV、FLAC、M4A、AAC、OGG、OPUS、AIFF、CAF、MP3 等未加密文件均可尝试。转换不是无损，320 kbps 会优先保留听感质量。</p>
          </div>
          <div class="audio-privacy-badge">
            <strong>不上传服务器</strong>
            <span>本机浏览器处理</span>
          </div>
        </div>

        <div class="audio-converter-grid">
          <div class="audio-input-column">
            <label class="audio-drop-zone" id="audioDropZone" for="audioFileInput">
              <span class="audio-drop-icon" aria-hidden="true">＋</span>
              <strong>拖入音频文件</strong>
              <span>或点击浏览，可批量选择</span>
              <small>单文件 ≤ 300 MB，单次最多 30 个</small>
              <input id="audioFileInput" type="file" accept="audio/*,.wav,.mp3,.m4a,.aac,.flac,.ogg,.oga,.opus,.aif,.aiff,.caf" multiple hidden />
            </label>
            <div class="audio-quality-row">
              <label for="audioQuality">输出品质</label>
              <select id="audioQuality">
                <option value="320" selected>320 kbps · 质量优先</option>
                <option value="256">256 kbps · 平衡</option>
                <option value="192">192 kbps · 节省空间</option>
                <option value="128">128 kbps · 体积最小</option>
              </select>
              <button class="audio-clear-button" id="audioClearQueue" type="button" disabled>清空列表</button>
            </div>
            <p class="audio-converter-hint">浏览器无法识别受保护内容。若文件本身有加密或 DRM，即使能选择也无法转换。</p>
          </div>

          <div class="audio-queue-panel" aria-live="polite">
            <div class="audio-queue-head">
              <div>
                <strong>转换队列</strong>
                <span>逐条输出，转换完成后单独下载</span>
              </div>
              <span id="audioQueueCount">0 个文件</span>
            </div>
            <div class="audio-queue" id="audioQueue">
              <div class="audio-queue-empty">还没有文件。拖入未加密音频，或点击左侧选择文件。</div>
            </div>
            <div class="audio-converter-actions">
              <button class="audio-convert-button" id="audioConvertButton" type="button" disabled>开始转换 MP3</button>
              <span class="audio-status" id="audioStatus" aria-live="polite"></span>
            </div>
          </div>
        </div>

        <div class="audio-format-notice">
          <strong>NCM、QMC、MGG、MFLAC 等加密格式暂不支持</strong>
          <span>这些格式通常需要移除内容保护才能读取。本站不提供解密、绕过 DRM 或破坏平台保护的功能，请使用合法来源和未加密母版。</span>
        </div>
      </div>
    </section>

    <section class="sfx-section" id="previews">
      <div class="section-head-sfx">
        <div>
          <span class="section-tag">婚礼配乐试听</span>
          <h2>先听情绪，再回官方下载</h2>
        </div>
        <p>Mixkit 官方免版税曲目，覆盖仪式、誓言、回忆、弟弟线和结尾拥抱等婚礼段落。</p>
      </div>

      <div class="preview-grid" id="sfxPreviewGrid">
        {soundPreviews.map((preview) => (
          <article
            class="sound-card"
            data-search-card
            data-search={`${preview.title} ${preview.titleZh} ${preview.category} ${preview.tags.join(' ')}`}
            data-audience={previewAudience(preview.category)}
          >
            <div class="sound-wave">
              <div class="wave-bars" aria-hidden="true">
                {waveformPeaks(preview.peaks).map((peak) => (
                  <span style={`height:${Math.max(12, Math.round(peak * 100))}%`}></span>
                ))}
              </div>
              <div class="sound-progress" aria-hidden="true"></div>
              <button
                class="sound-play"
                type="button"
                data-audio-src={preview.file}
                aria-label={`播放 ${preview.titleZh}`}
              >▶</button>
            </div>
            <div class="sound-body">
              <div class="sound-title-row">
                <div>
                  <h3>{preview.title}</h3>
                  <span class="sound-title-zh">{preview.titleZh} · {preview.artist}</span>
                </div>
                <span class="sound-duration">{preview.duration}</span>
              </div>
              <div class="tag-row">
                {preview.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
              </div>
              <div class="sound-footer">
                <span class="sound-license">{preview.source} · 官方试听</span>
                <a class="sound-download" href={preview.downloadUrl} target="_blank" rel="noopener" aria-label={`前往 ${preview.source} 下载 ${preview.titleZh}`}>官方下载 ↗</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="empty-state" id="sfxPreviewEmpty" hidden>没有匹配的试听素材，换个关键词试试。</p>
      <audio id="sfxAudio" preload="metadata"></audio>
    </section>

    <section class="sfx-section" id="categories">
      <div class="section-head-sfx">
        <div>
          <span class="section-tag">按用途找</span>
          <h2>先确定情绪和动作，再去找声音</h2>
        </div>
        <p>每个分类都给出多个来源，不同站点授权和检索方式不一样。</p>
      </div>

      <div class="category-grid" id="sfxCategoryGrid">
        {soundCategories.map((category) => (
          <article
            class="category-card"
            data-search-card
            data-search={`${category.title} ${category.titleEn} ${category.desc} ${category.tags.join(' ')}`}
            data-audience={category.audience.join(',')}
          >
            <div class="category-top">
              <span class="category-icon" aria-hidden="true">{category.icon}</span>
              <div>
                <h3>{category.title}</h3>
                <span class="category-en">{category.titleEn}</span>
              </div>
            </div>
            <p>{category.desc}</p>
            <div class="tag-row">
              {category.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
            </div>
            <div class="source-links">
              {category.sources.map((source) => (
                <a href={source.url} target="_blank" rel="noopener" class="source-pill">
                  <span class={`lic ${licenseStyles[source.license] || 'lic-mid'}`}>{source.license}</span>
                  <strong>{source.name}</strong>
                  <small>{source.note}</small>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
      <p class="empty-state" id="sfxCategoryEmpty" hidden>没有匹配的分类，试试“转场”“婚礼”“雨声”或“魔法”。</p>
    </section>

    <section class="sfx-section" id="sources">
      <div class="section-head-sfx">
        <div>
          <span class="section-tag">免版税来源</span>
          <h2>优先使用的免费素材站</h2>
        </div>
        <p>按“可商用 / 需署名 / 逐条确认”标注，交付前再看一次授权页面。</p>
      </div>

      <div class="source-grid" id="sfxSourceGrid">
        {soundSources.map((source) => (
          <a
            class="source-card"
            href={source.url}
            target="_blank"
            rel="noopener"
            data-search-card
            data-search={`${source.name} ${source.nameEn} ${source.desc} ${source.tags.join(' ')}`}
            data-audience={source.tags.join(',')}
          >
            <span class="source-top">
              <span class={`lic ${licenseStyles[source.license] || 'lic-mid'}`}>{source.license}</span>
              {source.recommended && <span class="reco">推荐</span>}
              <span class="region">{source.region}</span>
            </span>
            <strong>{source.name}</strong>
            <span class="source-en">{source.nameEn}</span>
            <span class="source-desc">{source.desc}</span>
            <span class="source-license">{source.licenseNote}</span>
            <span class="source-meta">
              {source.needsAccount ? '需要免费注册' : '通常无需注册'}
              {source.hasPaid ? ' · 含付费内容' : ''}
              <span class="source-arrow">↗</span>
            </span>
          </a>
        ))}
      </div>
      <p class="empty-state" id="sfxSourceEmpty" hidden>没有匹配的来源，换个关键词试试。</p>
    </section>

    <section class="sfx-section">
      <div class="section-head-sfx">
        <div>
          <span class="section-tag">下载前必看</span>
          <h2>授权检查四步法</h2>
        </div>
        <p>免费素材最容易踩的坑，不是找不到，而是没有确认授权。</p>
      </div>
      <div class="steps-grid">
        <article><strong>01</strong><h3>看许可证类型</h3><p>CC0 最省心，CC BY 要署名，CC BY-NC 通常不能商用。</p></article>
        <article><strong>02</strong><h3>看用途限制</h3><p>确认是否允许商业项目、客户交付、YouTube 变现和付费广告。</p></article>
        <article><strong>03</strong><h3>看再分发限制</h3><p>不要把音频本身上传到网盘、素材站或作为独立文件出售。</p></article>
        <article><strong>04</strong><h3>保存授权证据</h3><p>商单建议截图许可证页面，保存来源链接和下载日期。</p></article>
      </div>
      <div class="license-warning">
        <strong>特别注意</strong>
        <p>
          “免版税”不等于“无版权”，也不等于“可以随便转载”。如果客户要求独家授权、AI 训练授权或大规模广告投放，优先找 paid royalty-free 或直接联系作者购买扩展授权。
        </p>
      </div>
    </section>

    <section class="sfx-section">
      <div class="section-head-sfx">
        <div>
          <span class="section-tag">常见问题</span>
          <h2>免费下载前先搞清楚</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="sfx-cta">
      <div>
        <span class="section-tag">给婚礼剪辑用</span>
        <h2>音乐负责情绪，音效负责真实。</h2>
        <p>婚礼片先找钢琴、弦乐和心跳氛围，再用脚步、开门、风声、环境底噪补真实感。短剧则优先做转场、impact、riser 和 Foley。</p>
      </div>
      <div class="cta-links">
        <a class="hero-btn primary" href="/tools/">查看全部素材工具 →</a>
        <a class="hero-btn" href="/gold/">黄金与宏观资讯 →</a>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var search = document.getElementById('sfxSearch');
      var count = document.getElementById('sfxCount');
      var chips = Array.prototype.slice.call(document.querySelectorAll('.filter-chip[data-filter]'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('[data-search-card]'));
      var emptyCategory = document.getElementById('sfxCategoryEmpty');
      var emptySource = document.getElementById('sfxSourceEmpty');
      var emptyPreview = document.getElementById('sfxPreviewEmpty');
      var audio = document.getElementById('sfxAudio');
      var activeFilter = '全部';
      var activeButton = null;
      var activeCard = null;

      function resetPlaying() {
        if (activeCard) activeCard.classList.remove('playing');
        if (activeButton) activeButton.textContent = '▶';
        if (activeCard) activeCard.style.setProperty('--progress', '0%');
        activeButton = null;
        activeCard = null;
      }

      function applyFilter() {
        var query = (search && search.value ? search.value : '').trim().toLowerCase();
        var visible = 0;
        var categoryVisible = 0;
        var sourceVisible = 0;
        var previewVisible = 0;

        cards.forEach(function (card) {
          var text = (card.getAttribute('data-search') || '').toLowerCase();
          var audience = (card.getAttribute('data-audience') || '').split(',').map(function (item) { return item.trim(); });
          var matchesQuery = !query || text.indexOf(query) !== -1;
          var matchesFilter = activeFilter === '全部' || audience.indexOf(activeFilter) !== -1;
          var show = matchesQuery && matchesFilter;
          card.hidden = !show;
          if (show) {
            visible += 1;
            if (card.classList.contains('category-card')) categoryVisible += 1;
            if (card.classList.contains('source-card')) sourceVisible += 1;
            if (card.classList.contains('sound-card')) previewVisible += 1;
          }
        });

        if (count) count.textContent = '当前显示 ' + visible + ' 个结果';
        if (emptyCategory) emptyCategory.hidden = categoryVisible !== 0;
        if (emptySource) emptySource.hidden = sourceVisible !== 0;
        if (emptyPreview) emptyPreview.hidden = previewVisible !== 0;
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          activeFilter = chip.getAttribute('data-filter') || '全部';
          chips.forEach(function (item) {
            var active = item === chip;
            item.classList.toggle('active', active);
            item.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          applyFilter();
        });
      });

      if (search) search.addEventListener('input', applyFilter);

      if (audio) {
        audio.volume = 0.72;

        document.querySelectorAll('.sound-play[data-audio-src]').forEach(function (button) {
          button.addEventListener('click', function () {
            var src = button.getAttribute('data-audio-src');
            var card = button.closest('.sound-card');
            if (!src || !card) return;

            if (activeButton === button && !audio.paused) {
              audio.pause();
              button.textContent = '▶';
              card.classList.remove('playing');
              return;
            }

            resetPlaying();
            if (audio.getAttribute('src') !== src) {
              audio.setAttribute('src', src);
              audio.load();
            }
            activeButton = button;
            activeCard = card;
            card.classList.add('playing');
            button.textContent = 'Ⅱ';
            audio.play().catch(function () {
              resetPlaying();
            });
          });
        });

        audio.addEventListener('timeupdate', function () {
          if (!activeCard || !audio.duration || !isFinite(audio.duration)) return;
          var progress = Math.max(0, Math.min(100, (audio.currentTime / audio.duration) * 100));
          activeCard.style.setProperty('--progress', progress + '%');
        });

        audio.addEventListener('pause', function () {
          if (!audio.ended && activeButton) activeButton.textContent = '▶';
        });

        audio.addEventListener('ended', resetPlaying);
      }
    })();
  </script>
