---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '黄金行情与宏观资讯 · MacMP';
const description =
  '伦敦金多周期 K 线（5 分钟 / 15 分钟 / 1 小时 / 4 小时 / 日线 / 月线）、美联储与白宫官方来源、黄金相关宏观事件说明。行情延迟取决于数据源，仅提供信息参考，不构成投资建议。';
const path = '/gold';

const sources = [
  {
    name: '美联储 · 新闻稿',
    desc: '利率决议、政策声明、讲话与监管公告。',
    url: 'https://www.federalreserve.gov/newsevents/pressreleases.htm',
    tag: 'Fed',
  },
  {
    name: '美联储 · FOMC 日历',
    desc: '议息会议时间、声明和会议纪要入口。',
    url: 'https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm',
    tag: 'Fed',
  },
  {
    name: '白宫 · 简报室',
    desc: '总统讲话、行政令、财政与关税相关政策。',
    url: 'https://www.whitehouse.gov/briefing-room/',
    tag: 'White House',
  },
  {
    name: '美国财政部 · 新闻',
    desc: '国债发行、财政政策与经济数据发布。',
    url: 'https://home.treasury.gov/news/press-releases',
    tag: 'Treasury',
  },
  {
    name: '美国劳工统计局 · 发布日历',
    desc: 'CPI、非农就业、失业率等重要数据时间表。',
    url: 'https://www.bls.gov/schedule/news_release/',
    tag: 'BLS',
  },
  {
    name: 'CFTC · 持仓报告',
    desc: '黄金期货与期权的投机、商业持仓变化。',
    url: 'https://www.cftc.gov/MarketReports/CommitmentsofTraders/index.htm',
    tag: 'CFTC',
  },
  {
    name: 'LBMA · 贵金属价格',
    desc: '伦敦金、白银等贵金属基准价格与历史数据。',
    url: 'https://www.lbma.org.uk/prices-and-data/precious-metal-prices',
    tag: 'LBMA',
  },
  {
    name: 'SPDR Gold Shares',
    desc: '全球大型黄金 ETF 的持仓与资金变化入口。',
    url: 'https://www.spdrgoldshares.com/',
    tag: 'ETF',
  },
];

const factors = [
  {
    icon: '🏦',
    title: '美联储利率与美元',
    desc: '利率预期、美元指数和美债收益率，通常会影响黄金的持有成本与资金偏好。',
  },
  {
    icon: '📊',
    title: 'CPI 与就业数据',
    desc: '通胀和就业数据会改变市场对加息、降息的判断，是黄金短线波动的重要来源。',
  },
  {
    icon: '🏛️',
    title: '白宫财政与关税',
    desc: '财政扩张、关税政策、地缘风险等消息，可能提升避险需求，也可能先引发流动性冲击。',
  },
  {
    icon: '📈',
    title: '期货与 ETF 持仓',
    desc: 'CFTC 持仓、COMEX 成交和 ETF 持仓可以作为资金情绪参考，但不等于全市场主力资金。',
  },
];

const faqs = [
  {
    q: '这里的伦敦金 K 线是实时行情吗？',
    a: '页面使用 TradingView Lightweight Charts 绘图组件，数据来自东方财富公开行情接口。默认显示 5 分钟 K 线，并可切换 15 分钟、1 小时、4 小时、日线和月线。公开接口可能存在延迟；K线周期不等于数据延迟。正式交易请以持牌机构数据为准。',
  },
  {
    q: '能做到严格 5 分钟延迟吗？',
    a: '可以设定 5 分钟 K 线周期，但“数据延迟不超过 5 分钟”属于行情授权与数据源问题。当前免费方案只展示公开行情，不能承诺严格 5 分钟延迟；要严格做到，需要接入提供 5 分钟延迟或实时授权的数据商、经纪商行情，并确认商用再分发许可。',
  },
  {
    q: 'VIP 能看到主力资金买入和卖出吗？',
    a: '当前不做。伦敦金是场外市场，没有统一的全市场“主力资金”口径。可展示的只能是 CFTC 持仓、期货成交、ETF 持仓等参考指标，不能宣称能识别所有主力买卖。',
  },
  {
    q: '这里会提供买卖建议吗？',
    a: '不会。页面只做行情入口、官方来源导航和宏观背景说明，不提供个性化投资建议、跟单信号或收益承诺。公开行情可能延迟，任何交易决策都应以持牌机构数据为准。',
  },
  {
    q: '为什么只链接官方新闻源？',
    a: '官方来源更便于核查，也避免未经授权转载新闻全文。后续如果要接入付费新闻源，需要先确认授权范围和商用许可。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: new URL(path, Astro.site).toString(),
  about: ['伦敦金', '黄金', '美联储', '白宫', '宏观资讯'],
  isAccessibleForFree: true,
  significantLink: sources.map((source) => source.url),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout title={title} description={description} path={path}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="gold-hero">
    <div class="container">
      <p class="eyebrow">MacMP · 财经信息</p>
      <h1>伦敦金行情<br />与宏观资讯</h1>
      <p class="hero-lead">
        一个克制的黄金信息入口：看 5 分钟、15 分钟、1 小时、4 小时、日线和月线 K 线，查美联储和白宫官方来源，理解会影响金价的宏观变量。
        不喊单、不承诺收益，也不把场外市场包装成“主力资金内幕”。
      </p>
      <div class="hero-actions">
        <a class="btn primary" href="#market">查看行情 →</a>
        <a class="btn" href="#sources">官方来源 →</a>
      </div>
      <div class="hero-meta">
        <span><strong>6</strong> 个 K 线周期</span>
        <span><strong>8</strong> 个官方来源入口</span>
        <span><strong>0</strong> 买卖建议</span>
      </div>
    </div>
  </section>

  <div class="container gold-shell">
    <div class="risk-banner">
      <strong>风险提示</strong>
      <p>
        本页仅为金融信息与数据工具导航，不构成投资建议、收益承诺或交易依据。黄金价格受宏观数据、政策、汇率和流动性影响，可能出现剧烈波动。第三方行情可能有延迟；5 分钟 K 线周期不等于数据延迟一定不超过 5 分钟。正式交易请以持牌机构数据为准。
      </p>
    </div>

    <section class="market-grid" id="market">
      <div class="chart-card">
        <div class="card-head">
          <div>
            <span class="tag">行情图表</span>
            <h2>XAU/USD · 伦敦金</h2>
          </div>
          <a href="https://quote.eastmoney.com/q/122.XAU.html" target="_blank" rel="noopener">打开完整行情 →</a>
        </div>
        <p class="chart-note">默认 5 分钟；上方可切换 15 分钟、1 小时、4 小时、日线、月线。优先读取东方财富伦敦金公开行情；接口受限时自动切换为 PAXG/USD 黄金参考 K 线。</p>
        <div class="timeframe-bar" role="group" aria-label="K线周期">
          <button type="button" class="tf-btn active" data-tf="5" aria-pressed="true">5 分钟</button>
          <button type="button" class="tf-btn" data-tf="15" aria-pressed="false">15 分钟</button>
          <button type="button" class="tf-btn" data-tf="60" aria-pressed="false">1 小时</button>
          <button type="button" class="tf-btn" data-tf="240" aria-pressed="false">4 小时</button>
          <button type="button" class="tf-btn" data-tf="1D" aria-pressed="false">日线</button>
          <button type="button" class="tf-btn" data-tf="1M" aria-pressed="false">月线</button>
          <span class="pro-tools">可添加：MA / EMA / 成交量 / RSI / MACD / 布林带</span>
        </div>
        <div id="tv-gold-chart" class="gold-chart" aria-label="伦敦金 K 线图"></div>
        <p class="chart-fallback" id="goldChartStatus">正在连接伦敦金公开行情…</p>
        <script src="https://unpkg.com/lightweight-charts@4.2.2/dist/lightweight-charts.standalone.production.js" is:inline></script>
        <script is:inline>
          (function () {
            var container = document.getElementById('tv-gold-chart');
            var status = document.getElementById('goldChartStatus');
            var buttons = Array.prototype.slice.call(document.querySelectorAll('.tf-btn[data-tf]'));
            if (!container || !window.LightweightCharts) {
              if (status) status.textContent = '图表组件加载失败，请刷新页面后重试。';
              return;
            }

            var presets = {
              '5': { klt: '5', lmt: 260, seconds: 300, days: 1, label: '5 分钟' },
              '15': { klt: '15', lmt: 260, seconds: 900, days: 2, label: '15 分钟' },
              '60': { klt: '60', lmt: 320, seconds: 3600, days: 14, label: '1 小时' },
              '240': { klt: '60', lmt: 640, aggregate: 4, seconds: 14400, days: 30, label: '4 小时' },
              '1D': { klt: '101', lmt: 260, seconds: 86400, days: 365, label: '日线' },
              '1M': { klt: '103', lmt: 120, monthly: true, days: 365, label: '月线' }
            };
            var current = '5';
            var loading = false;
            var refreshTimer = null;
            var chart = window.LightweightCharts.createChart(container, {
              width: container.clientWidth,
              height: container.clientHeight,
              layout: { background: { color: '#ffffff' }, textColor: '#667085' },
              grid: {
                vertLines: { color: '#f0f2f5' },
                horzLines: { color: '#f0f2f5' }
              },
              crosshair: { mode: window.LightweightCharts.CrosshairMode.Normal },
              rightPriceScale: { borderColor: '#e4e8f0', scaleMargins: { top: 0.08, bottom: 0.22 } },
              timeScale: {
                borderColor: '#e4e8f0',
                timeVisible: true,
                secondsVisible: false,
                rightOffset: 4,
                barSpacing: 8
              },
              localization: {
                locale: 'zh-CN',
                priceFormatter: function (price) { return price.toFixed(2); }
              },
              handleScroll: true,
              handleScale: true
            });
            var candleSeries = chart.addCandlestickSeries({
              upColor: '#e55353',
              downColor: '#1f9d68',
              borderUpColor: '#e55353',
              borderDownColor: '#1f9d68',
              wickUpColor: '#e55353',
              wickDownColor: '#1f9d68',
              priceLineVisible: true,
              lastValueVisible: true
            });
            var volumeSeries = chart.addHistogramSeries({
              priceFormat: { type: 'volume' },
              priceScaleId: '',
              scaleMargins: { top: 0.82, bottom: 0 }
            });
            volumeSeries.priceScale().applyOptions({ scaleMargins: { top: 0.82, bottom: 0 } });
            var maConfigs = [
              { period: 5, color: '#0b66c3' },
              { period: 10, color: '#d69e2e' },
              { period: 20, color: '#7c3aed' }
            ];
            var maSeries = maConfigs.map(function (item) {
              return chart.addLineSeries({ color: item.color, lineWidth: 1, priceLineVisible: false, lastValueVisible: false });
            });

            function setStatus(text, isError) {
              if (!status) return;
              status.textContent = text;
              status.classList.toggle('is-error', !!isError);
            }

            function setActive(tf) {
              buttons.forEach(function (button) {
                var active = button.getAttribute('data-tf') === tf;
                button.classList.toggle('active', active);
                button.setAttribute('aria-pressed', active ? 'true' : 'false');
              });
            }

            function parseKlines(rows) {
              return rows.map(function (row) {
                var parts = row.split(',');
                var stamp = Date.parse(parts[0].replace(' ', 'T') + '+08:00');
                return {
                  time: Math.floor(stamp / 1000),
                  open: Number(parts[1]),
                  close: Number(parts[2]),
                  high: Number(parts[3]),
                  low: Number(parts[4]),
                  volume: Number(parts[5]) || 0
                };
              }).filter(function (item) {
                return Number.isFinite(item.time) && Number.isFinite(item.open) && Number.isFinite(item.close);
              }).sort(function (a, b) { return a.time - b.time; });
            }

            function aggregate(data, size) {
              if (size <= 1) return data;
              var result = [];
              var bucket = null;
              data.forEach(function (item) {
                var slot = Math.floor(item.time / (size * 3600)) * size * 3600;
                if (!bucket || bucket.time !== slot) {
                  if (bucket) result.push(bucket);
                  bucket = { time: slot, open: item.open, close: item.close, high: item.high, low: item.low, volume: item.volume };
                } else {
                  bucket.close = item.close;
                  bucket.high = Math.max(bucket.high, item.high);
                  bucket.low = Math.min(bucket.low, item.low);
                  bucket.volume += item.volume;
                }
              });
              if (bucket) result.push(bucket);
              return result;
            }

            function movingAverage(data, period) {
              var result = [];
              var sum = 0;
              for (var i = 0; i < data.length; i += 1) {
                sum += data[i].close;
                if (i >= period) sum -= data[i - period].close;
                if (i >= period - 1) result.push({ time: data[i].time, value: sum / period });
              }
              return result;
            }

            function render(data) {
              if (!data.length) throw new Error('empty data');
              candleSeries.setData(data);
              var hasVolume = data.some(function (item) { return item.volume > 0; });
              volumeSeries.setData(hasVolume ? data.map(function (item) {
                return {
                  time: item.time,
                  value: item.volume,
                  color: item.close >= item.open ? 'rgba(229,83,83,.34)' : 'rgba(31,157,104,.34)'
                };
              }) : []);
              chart.priceScale('right').applyOptions({ scaleMargins: { top: 0.08, bottom: hasVolume ? 0.22 : 0.04 } });
              maConfigs.forEach(function (item, index) {
                maSeries[index].setData(movingAverage(data, item.period));
              });
              chart.timeScale().fitContent();
            }

            function aggregatePrices(points, preset) {
              var result = [];
              var bucket = null;
              points.forEach(function (point) {
                var time = Math.floor(point[0] / 1000);
                var price = Number(point[1]);
                if (!Number.isFinite(time) || !Number.isFinite(price)) return;
                var slot;
                if (preset.monthly) {
                  var date = new Date(time);
                  slot = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), 1) / 1000;
                } else {
                  slot = Math.floor(time / preset.seconds) * preset.seconds;
                }
                if (!bucket || bucket.time !== slot) {
                  if (bucket) result.push(bucket);
                  bucket = { time: slot, open: price, close: price, high: price, low: price, volume: 0 };
                } else {
                  bucket.close = price;
                  bucket.high = Math.max(bucket.high, price);
                  bucket.low = Math.min(bucket.low, price);
                }
              });
              if (bucket) result.push(bucket);
              return result;
            }

            async function loadEastmoney(preset) {
              var params = new URLSearchParams({
                secid: '122.XAU',
                fields1: 'f1,f2,f3,f4,f5,f6',
                fields2: 'f51,f52,f53,f54,f55,f56,f57,f58,f59,f60,f61',
                klt: preset.klt,
                fqt: '1',
                beg: '0',
                end: '20500101',
                lmt: String(preset.lmt)
              });
              var response = await fetch('https://push2his.eastmoney.com/api/qt/stock/kline/get?' + params.toString(), { cache: 'no-store' });
              if (!response.ok) throw new Error('eastmoney http ' + response.status);
              var payload = await response.json();
              var rows = payload && payload.data && payload.data.klines;
              if (!rows || !rows.length) throw new Error('eastmoney empty');
              return aggregate(parseKlines(rows), preset.aggregate || 1);
            }

            async function loadPaxg(preset) {
              var url = 'https://api.coingecko.com/api/v3/coins/pax-gold/market_chart?vs_currency=usd&days=' + preset.days;
              var response = await fetch(url, { cache: 'no-store' });
              if (!response.ok) throw new Error('paxg http ' + response.status);
              var payload = await response.json();
              if (!payload || !payload.prices || !payload.prices.length) throw new Error('paxg empty');
              return aggregatePrices(payload.prices, preset);
            }

            async function load(tf, silent) {
              if (loading) return;
              var preset = presets[tf] || presets['5'];
              loading = true;
              if (!silent) setStatus('正在加载 ' + preset.label + ' 行情…');
              try {
                var liveData = await loadEastmoney(preset);
                render(liveData.slice(-240));
                var updated = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
                setStatus('东方财富 · 伦敦金公开行情 · ' + preset.label + ' · 更新于 ' + updated + ' · 可能存在延迟');
              } catch (primaryError) {
                try {
                  var fallbackData = await loadPaxg(preset);
                  render(fallbackData.slice(-240));
                  setStatus('PAXG/USD 黄金参考 K 线 · 数据来自 CoinGecko · 非伦敦金现货，仅用于趋势参考', false);
                } catch (fallbackError) {
                  setStatus('行情加载失败，请直接打开东方财富查看完整行情。', true);
                }
              } finally {
                loading = false;
              }
            }

            buttons.forEach(function (button) {
              button.addEventListener('click', function () {
                var tf = button.getAttribute('data-tf') || '5';
                current = tf;
                setActive(tf);
                load(tf, false);
              });
            });

            function resize() {
              chart.applyOptions({ width: container.clientWidth, height: container.clientHeight });
            }
            if (window.ResizeObserver) {
              new ResizeObserver(resize).observe(container);
            } else {
              window.addEventListener('resize', resize);
            }

            load(current, false);
            refreshTimer = window.setInterval(function () { load(current, true); }, 60000);
          })();
        </script>
      </div>

      <aside class="side-stack">
        <div class="side-card">
          <span class="tag">先看什么</span>
          <h3>黄金观察清单</h3>
          <ol class="check-list">
            <li><strong>利率预期</strong><span>美联储决议、点阵图、官员讲话</span></li>
            <li><strong>通胀与就业</strong><span>CPI、PCE、非农和失业率</span></li>
            <li><strong>美元与美债</strong><span>DXY、10 年期美债收益率</span></li>
            <li><strong>资金参考</strong><span>CFTC 持仓、ETF 持仓、期货成交</span></li>
          </ol>
        </div>
        <div class="side-card warning-card">
          <span class="tag warning">我们不做</span>
          <h3>避免误导性信号</h3>
          <ul class="no-list">
            <li>不宣称存在统一的全市场“主力资金”</li>
            <li>不提供买入、卖出或持仓建议</li>
            <li>不承诺收益，不展示“稳赚”案例</li>
            <li>不把延迟行情包装成实时交易数据</li>
          </ul>
        </div>
      </aside>
    </section>

    <section class="gold-section" id="sources">
      <div class="section-title">
        <div>
          <span class="tag">官方来源</span>
          <h2>白宫、美联储与黄金相关数据</h2>
        </div>
        <p>只做来源导航，不复制新闻全文。每张卡片都直达原始页面。</p>
      </div>
      <div class="source-grid">
        {sources.map((source) => (
          <a class="source-card" href={source.url} target="_blank" rel="noopener">
            <span class="source-top">
              <span class="source-tag">{source.tag}</span>
              <span class="source-arrow">↗</span>
            </span>
            <strong>{source.name}</strong>
            <span>{source.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="gold-section">
      <div class="section-title">
        <div>
          <span class="tag">宏观框架</span>
          <h2>影响黄金的四个变量</h2>
        </div>
        <p>不是预测涨跌，而是先建立一套不容易被单一新闻带跑的观察框架。</p>
      </div>
      <div class="factor-grid">
        {factors.map((factor) => (
          <article class="factor-card">
            <span class="factor-icon">{factor.icon}</span>
            <h3>{factor.title}</h3>
            <p>{factor.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="gold-section">
      <div class="section-title">
        <div>
          <span class="tag">常见问题</span>
          <h2>先把边界说清楚</h2>
        </div>
        <p>这个页面的价值是减少噪音，不是制造交易焦虑。</p>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="next-card">
      <div>
