---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { apps } from '../../data/apps';
import { affiliates } from '../../data/affiliates';
import type { App } from '../../data/apps';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

interface Props {
  app: App;
}

const { app } = Astro.props;
const aff = affiliates[app.affiliate];
const isGeneric = app.affiliate === 'generic';
const ctaUrl = isGeneric ? app.url : aff.url;
const ctaLabel = isGeneric ? '前往官网' : `前往 ${aff.name}`;
---
<BaseLayout title={`${app.name} 评测推荐 · MacMP`} description={app.tagline} path={`/software/${app.slug}`}>
  <div class="container">
    <article class="article">
      <span class="cat">{app.category}</span>
      <h1>{app.name}</h1>
      <div class="meta">
        {app.price} · {app.setapp ? '可订阅 Setapp' : '独立购买'}
      </div>
      <p style="font-size:17px">{app.tagline}</p>
      <p>{app.description}</p>

      {app.bestFor && (
        <section>
          <h2>适合谁</h2>
          <p>{app.bestFor}</p>
        </section>
      )}

      {app.pros && app.pros.length > 0 && (
        <section>
          <h2>优点</h2>
          <ul>{app.pros.map((p) => <li>{p}</li>)}</ul>
        </section>
      )}

      {app.cons && app.cons.length > 0 && (
        <section>
          <h2>不足</h2>
          <ul>{app.cons.map((c) => <li>{c}</li>)}</ul>
        </section>
      )}

      <div class="affiliate-box">
        <h3>获取 {app.name}</h3>
        <p>
          通过下方链接购买不会增加你的花费，但能为我们带来佣金（{aff.commission}），
          帮助我们持续产出内容，感谢支持 🙏
        </p>
        <p><a class="btn" href={ctaUrl} rel="nofollow sponsored" target="_blank">{ctaLabel} →</a></p>
        <p style="font-size:13px;margin-top:8px">{aff.note}</p>
      </div>
    </article>

    <Comments />
  </div>
</BaseLayout>
