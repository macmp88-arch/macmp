---
const items = [
  { zh: '微信支付', en: 'WeChat Pay', src: '/images/pay-wechat.jpg', alt: '微信支付二维码' },
  { zh: '支付宝', en: 'Alipay', src: '/images/pay-alipay.jpg', alt: '支付宝二维码' },
];
---
<section class="donate" id="donate">
  <h2><span class="zh">支持 MacMP</span><span class="en">Support MacMP</span></h2>
  <p><span class="zh">如果你觉得内容有帮助，欢迎扫码请我们喝杯咖啡 ☕ 你的支持会让我们走得更远。</span><span class="en">If you find our content helpful, buy us a coffee ☕ — your support keeps us going.</span></p>
  <div class="donate-grid">
    {items.map((item) => (
      <figure>
        <img src={item.src} alt={item.alt} loading="lazy" width="260" height="380" />
        <figcaption><span class="zh">{item.zh}</span><span class="en">{item.en}</span></figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .donate { text-align: center; padding: 48px 0 8px; }
  .donate h2 { font-size: 30px; letter-spacing: -0.015em; margin: 0 0 8px; }
  .donate > p { color: var(--ink-2); max-width: 480px; margin: 0 auto 24px; }
  .donate-grid {
    display: flex;
    gap: 28px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .donate-grid figure { margin: 0; }
  .donate-grid img {
    width: 240px;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: #fff;
  }
  .donate-grid figcaption { margin-top: 10px; font-size: 15px; font-weight: 600; }
</style>
