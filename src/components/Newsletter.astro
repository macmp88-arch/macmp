---
import { getNewsletterForm } from '../data/site';
const { action, field, configured } = getNewsletterForm();
---
<section class="newsletter" id="subscribe">
  <h2>订阅 MacMP 精选</h2>
  <p>每周一封：好用的 Mac 软件、限免优惠与本地 AI 教程，不打扰、可随时退订。</p>
  <form class="newsletter-form" action={action || '#'} method="post" target={configured ? '_blank' : undefined}>
    <input type="email" name={field} placeholder="你的邮箱地址" required />
    <button type="submit">订阅</button>
  </form>
  {!configured && <p class="newsletter-hint">订阅通道即将上线，敬请期待。</p>}
</section>

<style>
  .newsletter {
    text-align: center;
    background: var(--bg-2);
    border-radius: var(--radius-lg);
    padding: 48px 24px;
    margin-top: 48px;
  }
  .newsletter h2 {
    font-size: 30px;
    letter-spacing: -0.015em;
    margin: 0 0 8px;
  }
  .newsletter p { color: var(--ink-2); margin: 0 auto 20px; max-width: 480px; }
  .newsletter-form {
    display: flex;
    gap: 10px;
    justify-content: center;
    max-width: 440px;
    margin: 0 auto;
  }
  .newsletter-form input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 980px;
    font-size: 15px;
    outline: none;
    background: #fff;
  }
  .newsletter-form input:focus { border-color: var(--blue); }
  .newsletter-form button {
    padding: 12px 24px;
    border: 0;
    border-radius: 980px;
    background: var(--blue);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .newsletter-form button:hover { background: var(--blue-hover); }
  .newsletter-hint { font-size: 13px; color: #bf4800; margin-top: 12px; }
  @media (max-width: 640px) {
    .newsletter-form { flex-direction: column; }
  }
</style>

{!configured && (
  <script>
    const form = document.querySelector<HTMLFormElement>('.newsletter-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (form.querySelector('input[type=email]') as HTMLInputElement).value;
      if (email) alert('感谢订阅！订阅通道即将上线，我们会尽快接入邮件服务。');
    });
  </script>
)}
